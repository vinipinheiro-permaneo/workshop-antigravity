# Copie para .env nesta mesma pasta. O .env NUNCA vai para o git (já está no .gitignore).
# Formato de variáveis do google-adk 2.3.0 (o mesmo que o `adk create` gera).

# Opção 1: chave do Google AI Studio (confira a cota e o preço da sua conta antes)
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=

# Opção 2 (💲): projeto de TESTES no Google Cloud, nunca o de produção
# GOOGLE_GENAI_USE_ENTERPRISE=1
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Modelo (padrão do `adk create` na 2.3.0)
ADK_MODELO=gemini-3.5-flash
