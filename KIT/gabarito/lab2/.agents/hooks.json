{
  "guarda-de-custo": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "python hooks/guarda_custo.py", "timeout": 10 }
        ]
      }
    ]
  },
  "verificar-antes-de-parar": {
    "Stop": [
      { "type": "command", "command": "python hooks/verificar_antes_de_parar.py", "timeout": 30 }
    ]
  }
}
